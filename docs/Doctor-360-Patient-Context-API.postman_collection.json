{
  "info": {
    "name": "Doctor’s 360 · Patient Context API (Draft)",
    "_postman_id": "doctor360-context-draft-20260929",
    "description": "Contract examples for synthetic fixtures. HTTP semantics follow RFC 9110; error bodies follow RFC 9457. Requires a backend implementation. No live RS Bunda endpoint or data is connected.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "accessToken",
      "value": "REPLACE_WITH_DEV_TOKEN"
    },
    {
      "key": "patientId",
      "value": "SYN-BUNDA-P0001"
    },
    {
      "key": "encounterId",
      "value": "enc-demo-100-v1-0001"
    },
    {
      "key": "sourceId",
      "value": "SYN-BUNDA-V0001-01-SRC"
    },
    {
      "key": "importJobId",
      "value": "replace-after-import"
    },
    {
      "key": "queueItemId",
      "value": "replace-after-queue"
    },
    {
      "key": "summaryJobId",
      "value": "replace-after-summary-job"
    },
    {
      "key": "summaryId",
      "value": "replace-after-job-ready"
    }
  ],
  "item": [
    {
      "name": "01 · Import fixtures (Admin)",
      "item": [
        {
          "name": "Start import · 100 rows",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json, application/problem+json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/import-jobs"
            },
            "description": "Already staged synthetic fixture; server processes asynchronously.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fixture_reference\": \"demo-100-v1\",\n  \"expected_rows\": 100\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 202\", () => pm.response.to.have.status(202));",
                  "pm.test(\"Content-Type application/json\", () => pm.expect(pm.response.headers.get(\"Content-Type\") || \"\").to.include(\"application/json\"));",
                  "if (pm.response.code === 202) { const data = pm.response.json(); if (data.import_job_id) pm.collectionVariables.set(\"importJobId\", data.import_job_id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Start import · 1,000 rows",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json, application/problem+json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/import-jobs"
            },
            "description": "Import under a separate immutable dataset_id.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fixture_reference\": \"demo-1000-v1\",\n  \"expected_rows\": 1000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 202\", () => pm.response.to.have.status(202));",
                  "pm.test(\"Content-Type application/json\", () => pm.expect(pm.response.headers.get(\"Content-Type\") || \"\").to.include(\"application/json\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Start import · 1,000,000 rows",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json, application/problem+json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/import-jobs"
            },
            "description": "Never merge overlapping fixture patient IDs.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fixture_reference\": \"demo-1000000-v1\",\n  \"expected_rows\": 1000000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 202\", () => pm.response.to.have.status(202));",
                  "pm.test(\"Content-Type application/json\", () => pm.expect(pm.response.headers.get(\"Content-Type\") || \"\").to.include(\"application/json\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Read import job",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json, application/problem+json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/import-jobs/{{importJobId}}"
            },
            "description": "Check imported/rejected counts and publication status."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Content-Type application/json\", () => pm.expect(pm.response.headers.get(\"Content-Type\") || \"\").to.include(\"application/json\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 · Patient Context API",
      "item": [
        {
          "name": "Search patients",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json, application/problem+json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/patients?query=SYN-BUNDA-P0001&limit=20"
            },
            "description": "Cursor pagination and authorized patient scope."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Content-Type application/json\", () => pm.expect(pm.response.headers.get(\"Content-Type\") || \"\").to.include(\"application/json\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get patient header",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json, application/problem+json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/patients/{{patientId}}"
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Content-Type application/json\", () => pm.expect(pm.response.headers.get(\"Content-Type\") || \"\").to.include(\"application/json\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get encounter timeline",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json, application/problem+json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/patients/{{patientId}}/encounters?limit=20"
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Content-Type application/json\", () => pm.expect(pm.response.headers.get(\"Content-Type\") || \"\").to.include(\"application/json\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get curated context",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json, application/problem+json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/patients/{{patientId}}/context?encounter_id={{encounterId}}"
            },
            "description": "Backend-only authorized context; no model direct DB access."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Content-Type application/json\", () => pm.expect(pm.response.headers.get(\"Content-Type\") || \"\").to.include(\"application/json\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get encounter",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json, application/problem+json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/encounters/{{encounterId}}"
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Content-Type application/json\", () => pm.expect(pm.response.headers.get(\"Content-Type\") || \"\").to.include(\"application/json\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Open original source",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json, application/problem+json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/sources/{{sourceId}}"
            },
            "description": "Source ID must belong to authorized patient context."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Content-Type application/json\", () => pm.expect(pm.response.headers.get(\"Content-Type\") || \"\").to.include(\"application/json\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 · Queue and summaries",
      "item": [
        {
          "name": "Assign to doctor queue",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json, application/problem+json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/queue-items"
            },
            "description": "Nurse role; returned Location identifies created queue item.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patient_id\": \"{{patientId}}\",\n  \"encounter_id\": \"{{encounterId}}\",\n  \"doctor_id\": \"demo-doctor-01\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Content-Type application/json\", () => pm.expect(pm.response.headers.get(\"Content-Type\") || \"\").to.include(\"application/json\"));",
                  "if (pm.response.code === 201) { const data = pm.response.json(); if (data.queue_item_id) pm.collectionVariables.set(\"queueItemId\", data.queue_item_id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Get my queue",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json, application/problem+json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/doctors/me/queue"
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Content-Type application/json\", () => pm.expect(pm.response.headers.get(\"Content-Type\") || \"\").to.include(\"application/json\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Prepare summary",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json, application/problem+json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "demo-preload-{{encounterId}}-001"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/encounters/{{encounterId}}/summary-jobs"
            },
            "description": "Send Idempotency-Key. This request accepts work, it does not return a completed summary.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"nurse_preload\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 202\", () => pm.response.to.have.status(202));",
                  "pm.test(\"Content-Type application/json\", () => pm.expect(pm.response.headers.get(\"Content-Type\") || \"\").to.include(\"application/json\"));",
                  "if (pm.response.code === 202) { const data = pm.response.json(); if (data.summary_job_id) pm.collectionVariables.set(\"summaryJobId\", data.summary_job_id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Poll summary job",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json, application/problem+json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/summary-jobs/{{summaryJobId}}"
            },
            "description": "queued, running, ready or failed; set summaryId when ready."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Content-Type application/json\", () => pm.expect(pm.response.headers.get(\"Content-Type\") || \"\").to.include(\"application/json\"));",
                  "if (pm.response.code === 200) { const data = pm.response.json(); if (data.summary_url) pm.collectionVariables.set(\"summaryId\", data.summary_url.split(\"/\").pop()); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Read stored summary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json, application/problem+json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/summaries/{{summaryId}}"
            },
            "description": "Each claim has backend-validated source IDs."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Content-Type application/json\", () => pm.expect(pm.response.headers.get(\"Content-Type\") || \"\").to.include(\"application/json\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Submit doctor feedback",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json, application/problem+json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/summaries/{{summaryId}}/feedback"
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": \"Incomplete\",\n  \"reason\": \"A visit is missing from the available source set.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Content-Type application/json\", () => pm.expect(pm.response.headers.get(\"Content-Type\") || \"\").to.include(\"application/json\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 · RFC 9457 error contracts",
      "item": [
        {
          "name": "Patient not found · 404 problem",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json, application/problem+json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/patients/SYN-BUNDA-UNKNOWN"
            },
            "description": "Expect application/problem+json; no patient details in error."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Content-Type application/problem+json\", () => pm.expect(pm.response.headers.get(\"Content-Type\") || \"\").to.include(\"application/problem+json\"));",
                  "const p = pm.response.json(); pm.test(\"RFC 9457 members\", () => { pm.expect(p.type).to.be.a(\"string\"); pm.expect(p.title).to.be.a(\"string\"); pm.expect(p.status).to.eql(pm.response.code); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid search limit · 422 problem",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json, application/problem+json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/patients?query=P&limit=-1"
            },
            "description": "Semantically invalid parameter; errors extension may point to limit."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 422\", () => pm.response.to.have.status(422));",
                  "pm.test(\"Content-Type application/problem+json\", () => pm.expect(pm.response.headers.get(\"Content-Type\") || \"\").to.include(\"application/problem+json\"));",
                  "const p = pm.response.json(); pm.test(\"RFC 9457 members\", () => { pm.expect(p.type).to.be.a(\"string\"); pm.expect(p.title).to.be.a(\"string\"); pm.expect(p.status).to.eql(pm.response.code); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
