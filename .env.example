# DATABASE_URL may be used instead of POSTGRES_URL.
DATABASE_URL=postgres://user:password@localhost:5432/cas_dummy
POSTGRES_URL=postgres://user:password@localhost:5432/cas_dummy
JWT_ISSUER=cas-dummy-api
JWT_AUDIENCE=cas-dummy-client
# Supply multiline RS256 PEM values through the process environment or a
# secret manager. See README.md; do not commit private-key material here.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=local-current
# During planned rotation, retain the old public key until every old access
# token has expired. Both variables must be set together.
JWT_PREVIOUS_KEY_ID=
JWT_PREVIOUS_PUBLIC_KEY=
JWT_ACCESS_TOKEN_TTL_SECONDS=900
CURSOR_SIGNING_KEY=replace-with-a-long-random-secret
FIXTURE_DIR=fixtures
WORKER_CONCURRENCY=1
DATABASE_POOL_MAX=5
API_BIND_ADDR=127.0.0.1:8000
API_PUBLIC_BASE_URL=http://localhost:8000
ACTIVE_DATASET_ID=demo-1000000-v1
SUMMARY_LEASE_SECONDS=60
SUMMARY_MAX_ATTEMPTS=3

# Optional local-development settings. Keep private keys, database URLs and
# token configuration out of committed files.
POOL_MAX_CONNECTIONS=
DEV_TOKENS_CONFIG=
